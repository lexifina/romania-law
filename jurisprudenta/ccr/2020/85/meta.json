 "heading": "DECIZIA nr. 85 din 24 februarie 2020",
 "subtitle": "asupra cererilor de soluționare a conflictelor juridice de natură constituțională dintre Președintele României și Parlamentul României, formulate de președintele Camerei Deputaților și președintele Senatului",
 "issuer": "CURTEA CONSTITUȚIONALĂ",
 "mo": {
  "number": "195",
  "bis": false,
  "date": "2020-03-11",
  "part": "I"
 },
