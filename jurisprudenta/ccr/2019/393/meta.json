 "subjects": [
  {
   "act": {
    "kind": "proiect",
    "label": "Legea privind unele măsuri de regim fiscal derogatoriu aplicabil anumitor terenuri, construcții edificate pe acestea și anumitor activități economice autorizate"
   },
   "articles": []
  }
 ],
 "operative": [
  "Admite obiecțiile de neconstituționalitate formulate de 89 de deputați aparținând grupurilor parlamentare ale Partidului Național Liberal și Uniunii Salvați România și de Președintele României și constată că Legea privind unele măsuri de regim fiscal derogatoriu aplicabil anumitor terenuri, construcții edificate pe acestea și anumitor activități economice autorizate este neconstituțională în ansamblul său.",
  "Decizia se comunică Președintelui României, președinților celor două Camere ale Parlamentului și prim-ministrului și se publică în Monitorul Oficial al României, Partea I."
 ],
