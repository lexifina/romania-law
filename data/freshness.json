 "statuses": {
  "current": "checked against the official source within its threshold, and no known change is missing",
  "pending-change": "the official source reports a change (amendment, repeal, end of validity) this repository does not have yet",
  "stale": "not checked within its threshold",
  "unverified": "never checked against the official source for later changes",
  "source-unavailable": "due for a check, but the official source has not answered the latest checks"
 },
 "methods": {
  "amendment-search": "a full-text search of the official legislation service for the act's designation, every result read for a change to the act",
  "edition-index": "the official legislation service's list of every document, each scanned for acts it changes",
  "consolidated-form": "the act's newest consolidated form on the official portal, as the page stood on that day",
  "in-force-list": "the EU Publications Office's list of acts in force and their consolidated versions",
  "register-read": "the issuing council's or body's official register or site, read for the act's record"
